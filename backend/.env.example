# Copy to .env for local experiments. These are identifiers, not secrets.
# AWS credentials are never put here: on EC2 they come from the instance role.
PORT=8080
METRICS_PORT=9464
APP_VERSION=dev
NOTES_TABLE=SafeScribeNotes
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com
# DDB_ENDPOINT=http://127.0.0.1:8000   # local emulator only; leave unset on AWS
